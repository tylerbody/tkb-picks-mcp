{
  "name": "tkb-picks-mcp-server",
  "version": "2.6.4",
  "description": "MCP server for TKB Picks - wraps SportsGameOdds and BALLDONTLIE APIs for odds, schedules, stats, hit-rates, splits, and injuries across MLB, WNBA, NFL, NCAAF and ATP/WTA tennis (moneyline only).",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  }
}
